# Mapbox API Token
# Get your token from https://account.mapbox.com/access-tokens/
# This should be a public token with the required scopes for your application
PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Eco-Counter REST v2 (induction loops) — required for +page.server load()
ECO_COUNTER_API=your_eco_counter_api_key

# Vivacity (computer vision) — required for hardware/metadata merge and /api/vivacity-counter/*
VIVACITY_API=your_vivacity_api_key
