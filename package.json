{
	"name": "my-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "backfill:vivacity-monthly-bike": "node scripts/backfill-vivacity-monthly-bike.mjs",
    "export:vivacity-manifest": "node scripts/export-vivacity-sensor-manifest.mjs",
    "build:vivacity-sensor-snapshot": "python3 scripts/fetch_vivacity_sensor_timeseries_snapshot.py",
    "build:vivacity-sensor-snapshot:merge-missing": "python3 scripts/fetch_vivacity_sensor_timeseries_snapshot.py --merge-missing",
    "build:vivacity-sensor-snapshot:node": "node scripts/build-vivacity-sensor-timeseries-snapshot.mjs",
    "build:eco-counter-monthly-snapshot": "node scripts/build-eco-counter-monthly-snapshot.mjs",
    "build:eco-counter-monthly-snapshot:py": "python3 scripts/fetch_eco_counter_monthly_snapshot.py",
    "vivacity:list-new-sensors": "node scripts/list-vivacity-sensors-not-in-markers.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^7.0.4"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@vercel/kv": "^3.0.0",
		"mapbox-gl": "^3.14.0"
	}
